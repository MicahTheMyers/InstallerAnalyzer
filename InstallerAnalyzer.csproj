<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InstallerAnalyzer</AssemblyName>
    <RootNamespace>InstallerAnalyzer</RootNamespace>
    <ApplicationIcon>Assets\InstallerAnalyzer.ico</ApplicationIcon>
    <Version>0.9.5</Version>
    <AssemblyVersion>0.9.5.0</AssemblyVersion>
    <FileVersion>0.9.5.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\InstallerAnalyzer.ico" />
  </ItemGroup>
</Project>
