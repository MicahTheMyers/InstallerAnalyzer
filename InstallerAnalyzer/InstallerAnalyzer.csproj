<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseSystemDrawing>true</UseSystemDrawing>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InstallerAnalyzer</AssemblyName>
    <RootNamespace>InstallerAnalyzer</RootNamespace>
    <ApplicationIcon>Assets\InstallerAnalyzer.ico</ApplicationIcon>
    <Version>0.14.5</Version>
    <AssemblyVersion>0.14.5.0</AssemblyVersion>
    <FileVersion>0.14.5.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Services\PayloadTraceReducer.cs" LogicalName="InstallerAnalyzer.PayloadTraceReducer.cs" />
    <EmbeddedResource Include="Assets\catalog-server.txt" LogicalName="InstallerAnalyzer.catalog-server.txt" />
    <EmbeddedResource Include="Assets\release-update-public.pem" LogicalName="InstallerAnalyzer.release-update-public.pem" />
    <EmbeddedResource Include="Assets\catalog-signing-public.pem" LogicalName="InstallerAnalyzer.catalog-signing-public.pem" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.22" />
    <!-- Override the provider's old transitive bundle so published builds contain a patched native SQLite engine. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\InstallerAnalyzer.ico" />
  </ItemGroup>
</Project>

