<Window x:Class="InstallerAnalyzer.ArchiveInstallerWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Select ZIP installer" Width="660" Height="460" MinWidth="390" MinHeight="280"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ShowInTaskbar="False"
        Background="{DynamicResource Card}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="10"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
        <DockPanel Margin="16,0,8,0">
          <Button DockPanel.Dock="Right" Content="×" FontSize="17" Padding="10,1" VerticalAlignment="Center"
                  AutomationProperties.Name="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
          <TextBlock Text="Select ZIP installer" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Margin="20,16,20,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
          <TextBlock Text="Choose the main setup file" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Select the EXE or MSI that starts installation. Companion files stay in their folders."
                     Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="3">
          <TreeView x:Name="InstallerTree" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource Text}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    AutomationProperties.Name="Setup files in the ZIP">
            <TreeView.Resources>
              <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=OneWay}"/>
                <Setter Property="IsSelected" Value="{Binding Selected, Mode=OneWay}"/>
              </Style>
            </TreeView.Resources>
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="2,3" ToolTip="{Binding Entry}">
                  <TextBlock x:Name="FileIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE7C3;"
                             Foreground="{DynamicResource Muted}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                </StackPanel>
                <HierarchicalDataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Entry}" Value="{x:Null}">
                    <Setter TargetName="FileIcon" Property="Text" Value="&#xE8B7;"/>
                    <Setter TargetName="FileIcon" Property="Foreground" Value="{DynamicResource Accent}"/>
                  </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
          <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
          <Button x:Name="AnalyzeButton" Content="Analyze selected setup" IsDefault="True"
                  Style="{DynamicResource PrimaryButton}" Click="Analyze_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
