            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" MinHeight="220"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="14,10,14,6"><TextBlock Margin="0,0,0,8" Text="›_  Generated ImmyBot PowerShell" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Link}"/><WrapPanel><Button x:Name="InstallTabButton" Content="Install" Click="InstallTab_Click" Margin="0,0,5,0" Padding="12,7"/><Button x:Name="DetectionTabButton" Content="Detection" Click="DetectionTab_Click" Margin="0,0,5,0" Padding="12,7"/><Button x:Name="UninstallTabButton" Content="Uninstall" Click="UninstallTab_Click" Margin="0,0,5,0" Padding="12,7"/><Button Content="Intelligence" Click="IntelligenceTab_Click" Margin="0,0,6,0"/><Button x:Name="ValidationTabButton" Content="Validation" Click="ValidationTab_Click" Margin="0,0,10,0" Padding="12,7"/><Button Content="Copy" Click="Copy_Click" Margin="0,0,8,0" Padding="16,7"/><Button Content="Save .ps1" Click="Save_Click" Padding="16,7"/></WrapPanel></StackPanel><RichTextBox x:Name="ScriptBox" Grid.Row="1" Margin="12,0,12,12" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource CodeBg}" Foreground="#DCE7F5" BorderBrush="{DynamicResource Border}" Padding="10" IsDocumentEnabled="True"><FlowDocument PagePadding="0" Background="{DynamicResource CodeBg}"/></RichTextBox></Grid></Border>
