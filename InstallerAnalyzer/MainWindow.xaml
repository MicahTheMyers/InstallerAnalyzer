          <Grid Grid.Row="1" Margin="0,8,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ComboBox x:Name="AiTestBox" DisplayMemberPath="Label" SelectionChanged="AiTest_Changed" ToolTip="Test whose diagnostics will be included"/><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"><Button Content="Preview diagnostics" Click="AiPreview_Click" Padding="8,4" Margin="0,0,6,0"/><Button Content="Clear chat" Click="AiClear_Click" Padding="8,4"/></StackPanel></Grid>
          <ListBox x:Name="AiMessagesList" Grid.Row="2" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource InputBg}" BorderThickness="0" MinHeight="60"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,7"><TextBlock Text="{Binding Role}" Foreground="{DynamicResource Link}" FontWeight="Bold"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBox x:Name="AiQuestionBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" Height="56" Margin="0,8,0,6" ToolTip="Ask about the selected test. Ctrl+Enter sends." PreviewKeyDown="AiQuestion_KeyDown"/>
          <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="AiChatStatus" Text="Choose a test, then ask a question." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/><Button x:Name="AiExplainButton" Grid.Column="1" Content="Explain" Click="AiExplain_Click" Padding="8,5" Margin="0,0,5,0"/><Button x:Name="AiSendButton" Grid.Column="2" Content="Send" Style="{StaticResource PrimaryButton}" Click="AiSend_Click" Padding="8,5" Margin="0,0,5,0"/><Button x:Name="AiCancelButton" Grid.Column="3" Content="Cancel" Click="AiCancel_Click" Padding="8,5" IsEnabled="False"/></Grid>
        </Grid>
      </Border>
      </Grid>
      <Grid Grid.Row="2" Background="{DynamicResource Sidebar}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#35D07F" FontSize="14" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Grid.Column="1" x:Name="FooterVersionText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid>
    </Grid>
  </Border>
</Window>
