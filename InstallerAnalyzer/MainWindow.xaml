witch}" VerticalAlignment="Center" IsChecked="True" Checked="AppSetting_Changed" Unchecked="AppSetting_Changed"/></Grid></StackPanel></Border><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel Width="690"><TextBlock Text="Sandbox display mode" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Choose between a live integrated preview of Windows Sandbox or its normal separate window." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="EmbeddedModeRadio" Style="{StaticResource SegmentRadio}" Content="Integrated Viewer" GroupName="SandboxDisplayMode" IsChecked="False" Checked="SandboxDisplayMode_Changed"/><RadioButton x:Name="SeparateModeRadio" Style="{StaticResource SegmentRadio}" Grid.Column="2" Content="Separate Window (Recommended)" GroupName="SandboxDisplayMode" IsChecked="True" Checked="SandboxDisplayMode_Changed"/></Grid><TextBlock Text="Integrated Viewer keeps Windows Sandbox in its supported separate window and displays a live preview here. Use Bring to Front when you need direct mouse or keyboard interaction." Foreground="#E7B75D" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Width="690"><TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Installer Analyzer can check GitHub Releases for new versions. Updates are never installed without your approval." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Automatically check for updates" FontWeight="SemiBold"/><TextBlock Text="Checks at application startup." Foreground="{DynamicResource Muted}" Margin="0,4,20,0"/></StackPanel><ToggleButton x:Name="AutoUpdateToggle" Grid