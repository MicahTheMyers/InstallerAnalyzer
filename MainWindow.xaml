<Window x:Class="InstallerAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Installer Analyzer for ImmyBot" Height="900" Width="1240" MinHeight="760" MinWidth="1060"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Bg}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#08111F"/><SolidColorBrush x:Key="Sidebar" Color="#0B1626"/>
    <SolidColorBrush x:Key="Card" Color="#101C2B"/><SolidColorBrush x:Key="Border" Color="#22354B"/>
    <SolidColorBrush x:Key="Text" Color="#F4F7FB"/><SolidColorBrush x:Key="Muted" Color="#A7B4C7"/>
    <SolidColorBrush x:Key="Accent" Color="#1685FF"/><SolidColorBrush x:Key="AccentSoft" Color="#123967"/>
    <SolidColorBrush x:Key="InputBg" Color="#0B1625"/><SolidColorBrush x:Key="InputBorder" Color="#36506D"/>
    <SolidColorBrush x:Key="ButtonBg" Color="#14243A"/><SolidColorBrush x:Key="ButtonHover" Color="#1A3150"/>
    <SolidColorBrush x:Key="CodeBg" Color="#07111D"/><SolidColorBrush x:Key="Link" Color="#5FC7FF"/>
    <SolidColorBrush x:Key="ScrollTrackBg" Color="#09131F"/><SolidColorBrush x:Key="ScrollThumb" Color="#657C94"/><SolidColorBrush x:Key="ScrollThumbHover" Color="#8EA3B8"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource ButtonBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="9,7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource InputBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Style.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoft}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/></Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
              <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{DynamicResource Text}"/>
                <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280" Margin="0,3,0,0">
                  <ScrollViewer Margin="2" SnapsToDevicePixels="True"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="4"/></Style>
    <!-- Full-length browser-style scrollbars: the track fills the complete edge of the scrollable control and the thumb is a normal draggable viewport indicator. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource ScrollThumb}"/>
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid x:Name="ScrollTrack" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <Track x:Name="PART_Track"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="True"
                     Focusable="False">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="DecreaseButton" Background="Transparent" BorderThickness="0" Focusable="False" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb x:Name="ScrollThumb" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="{DynamicResource ScrollThumb}" CornerRadius="6" Margin="2"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="#8EA3B8"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource Accent}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="IncreaseButton" Background="Transparent" BorderThickness="0" Focusable="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageUpCommand"/>
                <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageDownCommand"/>
                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="42"/>
                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="14"/>
              </Trigger>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="14"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageRightCommand"/>
                <Setter TargetName="ScrollThumb" Property="MinWidth" Value="42"/>
                <Setter TargetName="ScrollThumb" Property="MinHeight" Value="14"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="Padding" Value="6"/></Style>
    <Style x:Key="SegmentRadio" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#A7B4C7"/><Setter Property="Background" Value="{DynamicResource InputBg}"/><Setter Property="BorderBrush" Value="#2A4059"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,11"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Segment" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="Mark" Text="" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource ButtonHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource AccentSoft}"/><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter TargetName="Mark" Property="Text" Value="✓"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/></Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="8,3"/><Setter Property="FontWeight" Value="Normal"/></Style>
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="Track" CornerRadius="13" Background="#33445A" BorderBrush="#486078" BorderThickness="1"/>
              <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Bg}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="{DynamicResource Sidebar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"><Image Source="Assets/logo.png" Width="25" Height="25" Margin="0,0,9,0"/><TextBlock Text="Installer Analyzer for ImmyBot" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
        <Button Grid.Column="1" Content="—" Background="Transparent" BorderBrush="Transparent" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><Button Grid.Column="2" Content="□" Background="Transparent" BorderBrush="Transparent" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><Button Grid.Column="3" Content="×" FontSize="18" Background="Transparent" BorderBrush="Transparent" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      </Grid>

      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,1,0"><StackPanel Margin="0,12">
          <Button x:Name="AnalyzeNavButton" Style="{StaticResource NavButton}" Background="{DynamicResource AccentSoft}" Click="AnalyzeNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="23" Foreground="{DynamicResource Accent}" Width="32"/><TextBlock Text="Analyze" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Style="{StaticResource NavButton}" Click="SandboxNav_Click" x:Name="SidebarSandboxButton"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="20" Width="32"/><TextBlock Text="Sandbox" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="ImmyBotNavButton" Style="{StaticResource NavButton}" Click="ImmyBotNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⇧" FontSize="20" Width="32"/><TextBlock Text="ImmyBot" VerticalAlignment="Center"/></StackPanel></Button>
          <Separator Margin="14,10" Background="{DynamicResource Border}"/>
          <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="32"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="AboutNavButton" Style="{StaticResource NavButton}" Click="AboutNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" FontSize="18" Width="32"/><TextBlock Text="About" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel></Border>

        <Grid Grid.Column="1">
          <Grid x:Name="AnalyzePage" Margin="22,18,22,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="Assets/logo.png" Width="68" Height="68" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="Installer Analyzer" FontSize="30" FontWeight="Bold"/><TextBlock Text="Inspect an installer without running it, then generate an ImmyBot PowerShell install script." Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,4,0,0"/></StackPanel></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Installer File" FontWeight="SemiBold" Margin="0,0,0,8"/><Border Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,8"><TextBlock x:Name="FileText" Text="Drop an .exe or .msi here" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></Border></StackPanel><Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Select Installer…" Click="Select_Click" Margin="14,25,0,0"/></Grid></Border>
            <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="▥  Analysis" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                <TextBlock Text="Installer type" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><ComboBox x:Name="KindBox" Grid.Column="1" SelectionChanged="KindBox_SelectionChanged" VerticalAlignment="Center" IsEditable="False" Foreground="{DynamicResource Text}" Background="{DynamicResource InputBg}"/>
                <TextBlock Grid.Row="1" Text="Confidence" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="ConfidenceText" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" x:Name="ConfidenceBar" Height="8" Minimum="0" Maximum="100" Background="#22354B" Foreground="{DynamicResource Accent}" BorderThickness="0"/></Grid>
                <TextBlock Grid.Row="2" Text="Architecture" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ArchText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Text="Product" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBox x:Name="ProductBox" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
                <TextBlock Grid.Row="4" Text="Company" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CompanyText" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="5" Text="Version" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="VersionText" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="⚙  Deployment settings" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/><TextBlock Text="Silent arguments" Foreground="{DynamicResource Muted}"/><TextBox x:Name="ArgumentsBox" Margin="0,6,0,12"/><CheckBox x:Name="IssCheck" Content="Requires setup.iss response file" Checked="IssCheck_Changed" Unchecked="IssCheck_Changed" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="RecordIssButton" Style="{StaticResource PrimaryButton}" Content="Generate setup.iss" Click="RecordIss_Click" Margin="0,0,10,0" IsEnabled="False"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Text="Sandbox" VerticalAlignment="Center" Margin="0,0,7,0"/><ToggleButton x:Name="SandboxToggle" Style="{StaticResource Switch}" IsChecked="True" Checked="SandboxToggle_Changed" Unchecked="SandboxToggle_Changed"/></StackPanel><Button Grid.Column="2" x:Name="OpenIssButton" Content="Open ISS folder" Click="OpenIss_Click" IsEnabled="False" HorizontalAlignment="Left"/></Grid>
                <TextBlock x:Name="IssStatusText" Text="Sandbox recorder is available for InstallShield response files." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Detection evidence" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/><ListBox x:Name="EvidenceList" Height="92"/>
              </StackPanel></Border>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0" MinHeight="220"><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="›_  Generated ImmyBot PowerShell" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Link}"/><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="InstallTabButton" Content="Install" Click="InstallTab_Click" Margin="0,0,5,0" Padding="12,7"/><Button x:Name="DetectionTabButton" Content="Detection" Click="DetectionTab_Click" Margin="0,0,5,0" Padding="12,7"/><Button x:Name="UninstallTabButton" Content="Uninstall" Click="UninstallTab_Click" Margin="0,0,5,0" Padding="12,7"/><Button x:Name="ValidationTabButton" Content="Validation" Click="ValidationTab_Click" Margin="0,0,10,0" Padding="12,7"/><Button Content="Copy" Click="Copy_Click" Margin="0,0,8,0" Padding="16,7"/><Button Content="Save .ps1" Click="Save_Click" Padding="16,7"/></StackPanel></Grid><RichTextBox x:Name="ScriptBox" Grid.Row="1" Margin="12,0,12,12" FontFamily="Cascadia Mono, Consolas" FontSize="13" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource CodeBg}" Foreground="#DCE7F5" BorderBrush="{DynamicResource Border}" Padding="10" IsDocumentEnabled="True"><FlowDocument PagePadding="0" Background="{DynamicResource CodeBg}"/></RichTextBox></Grid></Border>
          </Grid>

          <Grid x:Name="SandboxPage" Visibility="Collapsed" Margin="22,18,22,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sandbox Control Center" FontSize="30" FontWeight="Bold"/><TextBlock Text="Monitor, inspect, validate, and package the deployment." Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Display:" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="SandboxModeBadge" Text="Separate Window" FontWeight="SemiBold" Foreground="{DynamicResource Link}" VerticalAlignment="Center"/></StackPanel></Grid>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SandboxRunStatus" Text="Ready" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SandboxRunDetails" Text="Select an InstallShield installer on the Analyze page, then start Sandbox analysis here." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="StartSandboxButton" Style="{StaticResource PrimaryButton}" Content="▶  Start Sandbox Analysis" Click="RecordIss_Click" Margin="0,0,8,0"/><Button x:Name="BringSandboxFrontButton" Content="Open Sandbox" Click="BringSandboxFront_Click" IsEnabled="False"/></StackPanel></Grid></Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="LIVE PREVIEW" Foreground="{DynamicResource Link}" FontWeight="Bold" Margin="8,4,0,10"/><Border Grid.Row="1" x:Name="SandboxDisplayPlaceholder" Background="#050B13" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="7"><Grid><TextBlock x:Name="SandboxPlaceholderText" Text="Live Sandbox preview appears here in Integrated Viewer mode.&#10;&#10;When user input is required, click Open Sandbox." Foreground="{DynamicResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/><Image x:Name="SandboxPreviewImage" Visibility="Collapsed" Stretch="Uniform" SnapsToDevicePixels="True"/></Grid></Border></Grid></Border>
              <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="CURRENT STAGE" Foreground="{DynamicResource Link}" FontWeight="Bold" Margin="0,0,0,8"/><ListBox x:Name="SandboxStageList" BorderThickness="0" Background="Transparent" MinHeight="120"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="DISCOVERED APPLICATION" Foreground="{DynamicResource Link}" FontWeight="Bold"/><TextBlock x:Name="SandboxPrimaryText" Text="No primary application identified yet." FontSize="15" FontWeight="SemiBold" Margin="0,8,0,6" TextWrapping="Wrap"/><TextBlock Text="Dependencies / additional entries" Foreground="{DynamicResource Muted}"/><ListBox x:Name="SandboxDependencyList" BorderThickness="0" Background="Transparent" MaxHeight="105" Margin="0,5,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><StackPanel><TextBlock Text="GENERATED FILES" Foreground="{DynamicResource Link}" FontWeight="Bold"/><ListBox x:Name="SandboxFilesList" BorderThickness="0" Background="Transparent" MinHeight="70" Margin="0,6,0,0"/><Button Content="Open Output Folder" Click="OpenIss_Click" x:Name="SandboxOpenOutputButton" IsEnabled="False" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="DEPLOYMENT READINESS" Foreground="{DynamicResource Link}" FontWeight="Bold"/><TextBlock x:Name="DeploymentReadinessText" Text="Sandbox validation required" Foreground="#E7B75D" FontSize="18" FontWeight="Bold" Margin="0,9,0,4"/><TextBlock Text="Package contains only files ImmyBot needs uploaded. Scripts are copied from the ImmyBot page." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><Button x:Name="ExportImmyBotButton" Style="{StaticResource PrimaryButton}" Content="Create ImmyBot Package" Click="ExportImmyBot_Click" IsEnabled="False" HorizontalAlignment="Left"/></StackPanel></Border>
              </StackPanel></ScrollViewer>
            </Grid>
            <TextBlock Grid.Row="3" x:Name="SandboxArtifactText" Text="No Sandbox session has been started." Foreground="{DynamicResource Muted}" Margin="2,10,0,0" VerticalAlignment="Center"/>
          </Grid>

          <Grid x:Name="ImmyBotPage" Visibility="Collapsed" Margin="22,18,22,14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14"><TextBlock Text="ImmyBot Deployment" FontSize="30" FontWeight="Bold"/><TextBlock Text="Copy validated scripts into ImmyBot and export only the files that need uploading." Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/></StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="104" Height="104" Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="10"><Grid><TextBlock x:Name="ImmyLogoPlaceholder" Text="No logo" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ImmyLogoImage" Stretch="Uniform" Margin="8"/></Grid></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Application logo" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ImmyLogoStatus" Text="Select an installer to extract its icon." Foreground="{DynamicResource Muted}" Margin="0,5,0,10"/><StackPanel Orientation="Horizontal"><Button Content="Replace Image" Click="ReplaceLogo_Click" Margin="0,0,8,0"/><Button Content="Re-extract" Click="ReextractLogo_Click" Margin="0,0,8,0"/><Button Content="Remove" Click="RemoveLogo_Click"/></StackPanel></StackPanel></Grid></Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
              <Border Style="{StaticResource CardStyle}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Install Script" FontWeight="Bold" Foreground="{DynamicResource Link}"/><Button Grid.Column="1" Content="Copy Install" Click="CopyImmyInstall_Click" Padding="10,5" Margin="0,0,8,0"/><Button Grid.Column="2" x:Name="ImmyExportButton" Style="{StaticResource PrimaryButton}" Content="Create Upload ZIP" Click="ExportImmyBot_Click" IsEnabled="False" Padding="12,5"/></Grid><RichTextBox x:Name="ImmyInstallBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13" Margin="0,8,0,0" Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource Border}" Padding="9"><FlowDocument PagePadding="0" Background="{DynamicResource CodeBg}"/></RichTextBox></Grid></Border>
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Detection Script" FontWeight="Bold" Foreground="{DynamicResource Link}"/><Button Grid.Column="1" Content="Copy Detection" Click="CopyImmyDetection_Click" Padding="10,5"/></Grid><RichTextBox x:Name="ImmyDetectionBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13" Margin="0,8,0,0" Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource Border}" Padding="9"><FlowDocument PagePadding="0" Background="{DynamicResource CodeBg}"/></RichTextBox></Grid></Border>
              <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource CardStyle}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Uninstall Script" FontWeight="Bold" Foreground="{DynamicResource Link}"/><Button Grid.Column="1" Content="Copy Uninstall" Click="CopyImmyUninstall_Click" Padding="10,5"/></Grid><RichTextBox x:Name="ImmyUninstallBox" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13" Margin="0,8,0,0" Background="{DynamicResource CodeBg}" BorderBrush="{DynamicResource Border}" Padding="9"><FlowDocument PagePadding="0" Background="{DynamicResource CodeBg}"/></RichTextBox></Grid></Border>
            </Grid>
          </Grid>

          <Grid x:Name="SettingsPage" Visibility="Collapsed" Margin="34,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Settings" FontSize="30" FontWeight="Bold"/><TextBlock Grid.Row="1" Text="Appearance and Windows integration options" Foreground="{DynamicResource Muted}" Margin="0,5,0,20"/><StackPanel Grid.Row="2" MaxWidth="760" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel Width="690"><TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Choose a dark, super dark, light, full purple, or classic hacker interface and an accent color. Your selection is saved automatically." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/><TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel><RadioButton x:Name="DarkThemeRadio" Style="{StaticResource SegmentRadio}" Content="Dark" GroupName="AppTheme" Checked="Appearance_Changed" Width="158" Margin="0,0,10,10"/><RadioButton x:Name="SuperDarkThemeRadio" Style="{StaticResource SegmentRadio}" Content="Super Dark" GroupName="AppTheme" Checked="Appearance_Changed" Width="158" Margin="0,0,10,10"/><RadioButton x:Name="LightThemeRadio" Style="{StaticResource SegmentRadio}" Content="Light" GroupName="AppTheme" Checked="Appearance_Changed" Width="158" Margin="0,0,10,10"/><RadioButton x:Name="PurpleThemeRadio" Style="{StaticResource SegmentRadio}" Content="Purple" GroupName="AppTheme" Checked="Appearance_Changed" Width="158" Margin="0,0,10,10"/><RadioButton x:Name="HackerThemeRadio" Style="{StaticResource SegmentRadio}" Content="Hacker" GroupName="AppTheme" Checked="Appearance_Changed" Width="158" Margin="0,0,10,10"/></WrapPanel><TextBlock Text="Accent color" FontWeight="SemiBold" Margin="0,18,0,8"/><WrapPanel><RadioButton x:Name="BlueAccentRadio" Content="Blue" GroupName="AccentColor" Checked="Appearance_Changed" Margin="0,0,18,8"/><RadioButton x:Name="PurpleAccentRadio" Content="Purple" GroupName="AccentColor" Checked="Appearance_Changed" Margin="0,0,18,8"/><RadioButton x:Name="TealAccentRadio" Content="Teal" GroupName="AccentColor" Checked="Appearance_Changed" Margin="0,0,18,8"/><RadioButton x:Name="OrangeAccentRadio" Content="Orange" GroupName="AccentColor" Checked="Appearance_Changed" Margin="0,0,18,8"/><RadioButton x:Name="RedAccentRadio" Content="Red" GroupName="AccentColor" Checked="Appearance_Changed" Margin="0,0,18,8"/><RadioButton x:Name="GreenAccentRadio" Content="Green" GroupName="AccentColor" Checked="Appearance_Changed" Margin="0,0,18,8"/><RadioButton x:Name="PinkAccentRadio" Content="Pink" GroupName="AccentColor" Checked="Appearance_Changed" Margin="0,0,18,8"/><RadioButton x:Name="GoldAccentRadio" Content="Gold" GroupName="AccentColor" Checked="Appearance_Changed" Margin="0,0,18,8"/></WrapPanel></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel Width="690"><TextBlock Text="Windows Sandbox" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Windows Sandbox is used to safely record InstallShield setup.iss files and analyze installed applications." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="SettingsSandboxStatus" Text="Checking Windows Sandbox…" FontWeight="SemiBold"/><TextBlock Text="Use Windows Features to enable or disable the Windows Sandbox optional feature." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,20,0"/></StackPanel><ToggleButton x:Name="SettingsSandboxToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="SettingsSandboxToggle_Click"/></Grid><Button Content="Open Windows Features" Click="OpenWindowsFeatures_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel Width="690"><TextBlock Text="Sandbox display mode" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Choose between a live integrated preview of Windows Sandbox or its normal separate window." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="EmbeddedModeRadio" Style="{StaticResource SegmentRadio}" Content="Integrated Viewer" GroupName="SandboxDisplayMode" IsChecked="False" Checked="SandboxDisplayMode_Changed"/><RadioButton x:Name="SeparateModeRadio" Style="{StaticResource SegmentRadio}" Grid.Column="2" Content="Separate Window (Recommended)" GroupName="SandboxDisplayMode" IsChecked="True" Checked="SandboxDisplayMode_Changed"/></Grid><TextBlock Text="Integrated Viewer keeps Windows Sandbox in its supported separate window and displays a live preview here. Use Bring to Front when you need direct mouse or keyboard interaction." Foreground="#E7B75D" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Width="690"><TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Installer Analyzer can check GitHub Releases for new versions. Updates are never installed without your approval." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Automatically check for updates" FontWeight="SemiBold"/><TextBlock Text="Checks at application startup." Foreground="{DynamicResource Muted}" Margin="0,4,20,0"/></StackPanel><ToggleButton x:Name="AutoUpdateToggle" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Checked="AutoUpdateToggle_Changed" Unchecked="AutoUpdateToggle_Changed"/></Grid><Button Content="Check for Updates Now" Click="CheckForUpdates_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
          </StackPanel></Grid>

          <Grid x:Name="AboutPage" Visibility="Collapsed" Margin="34,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="About" FontSize="30" FontWeight="Bold"/><StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,20,0,0" Width="620"><Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><Image Source="Assets/logo.png" Width="90" Height="90" Margin="0,0,20,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Installer Analyzer for ImmyBot" FontSize="20" FontWeight="Bold"/><TextBlock Text="Version 0.9.5" Foreground="{DynamicResource Muted}" FontSize="14" Margin="0,7,0,0"/><TextBlock Text="github.com/MicahTheMyers/InstallerAnalyzer" Foreground="{DynamicResource Link}" Margin="0,5,0,0"/></StackPanel></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusText" Text="Click Check for Updates to query GitHub Releases." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14"/><StackPanel Orientation="Horizontal"><Button x:Name="CheckUpdateButton" Content="Check for Updates" Click="CheckForUpdates_Click" Margin="0,0,8,0"/><Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButton}" Content="Download &amp; Install Update" Click="InstallUpdate_Click" IsEnabled="False"/></StackPanel><TextBlock x:Name="ReleaseNotesText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0" MaxHeight="220"/></StackPanel></Border></StackPanel></Grid>
        </Grid>
      </Grid>

      <Grid Grid.Row="2" Background="{DynamicResource Sidebar}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#35D07F" FontSize="14" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource Muted}"/></StackPanel><TextBlock Grid.Column="1" Text="v0.9.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid>
    </Grid>
  </Border>
</Window>
